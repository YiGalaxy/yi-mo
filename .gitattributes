# 默认：文本文件在仓库里统一用 LF
* text=auto eol=lf

# Windows 批处理必须用 CRLF，否则可能执行失败
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做行尾转换
*.png  binary
*.jpg  binary
*.gif  binary
*.ico  binary
*.icns binary
*.jar  binary
*.zip  binary
*.woff binary
*.woff2 binary

# 锁文件不要合并冲突，直接重新生成
package-lock.json  -diff
pnpm-lock.yaml     -diff
